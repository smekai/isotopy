{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    "paths": {
      "@isotopy/core": ["../core/src/index.ts"]
    }
  },
  // test/ holds unit specs for the pure helpers in src/. Safe to include here:
  // this config is noEmit (Vite does the bundling from index.html), so nothing
  // from test/ can reach dist/.
  "include": ["src", "test"]
}
