{
  "name": "@isotopy/server",
  "version": "0.12.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-skill-assets.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@isotopy/core": "workspace:*",
    "@hono/node-server": "^1.14.1",
    "hono": "^4.7.6",
    "openworkflow": "^0.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.19.3"
  }
}
