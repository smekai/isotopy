# Copy to .env and adjust. Every value is optional — defaults are shown.
# Real env vars always win over this file. .env is gitignored (may hold paths/keys).

# --- Server (packages/server) ---
# Interface the API server binds to; use 0.0.0.0 to expose beyond this machine.
ADHD_HOST=localhost
# API server port (legacy alias: PORT).
ADHD_PORT=9477
# Comma-separated CORS allowlist; defaults to the UI and server origins below.
# ADHD_CORS_ORIGINS=http://localhost:5173,http://localhost:9477
# Hard cap for a single engine (CLI) run, in milliseconds.
ADHD_ENGINE_TIMEOUT_MS=600000
# Absolute path to the claude executable, if not on PATH.
# ADHD_CLAUDE_PATH=C:\Users\you\.local\bin\claude.exe

# --- UI dev server (packages/ui) ---
ADHD_UI_PORT=5173
# Where the Vite proxy sends API calls; defaults to http://localhost:${ADHD_PORT}.
# ADHD_SERVER_URL=http://localhost:9477
# Base URL Playwright tests target; defaults to http://localhost:${ADHD_UI_PORT}.
# ADHD_UI_URL=http://localhost:5173
