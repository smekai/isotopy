# Copy to .env and adjust. Every value is optional — defaults are shown.
# Real env vars always win over this file. .env is gitignored (may hold paths/keys).

# --- Server (packages/server) ---
# Everything Isotopy writes: run state, settings.json, personas. Defaults to
# .isotopy/ beside the repo. Point it elsewhere to keep data out of the checkout
# (the test suite uses this to run against a temp directory).
# ISOTOPY_HOME=C:\Users\you\AppData\Local\isotopy
# Interface the API server binds to; use 0.0.0.0 to expose beyond this machine.
ISOTOPY_HOST=localhost
# API server port (legacy alias: PORT).
ISOTOPY_PORT=9477
# Comma-separated CORS allowlist; defaults to the UI and server origins below.
# ISOTOPY_CORS_ORIGINS=http://localhost:5173,http://localhost:9477
# Hard cap for a single engine (CLI) run, in milliseconds.
ISOTOPY_ENGINE_TIMEOUT_MS=600000
# Absolute path to the claude executable, if not on PATH.
# ISOTOPY_CLAUDE_PATH=C:\Users\you\.local\bin\claude.exe
# Absolute path to the Cursor CLI (agent / cursor-agent) for a non-standard
# install. The default Windows install (%LOCALAPPDATA%\cursor-agent) is found
# automatically, so this is only needed if you put it elsewhere.
# ISOTOPY_CURSOR_PATH=C:\Users\you\AppData\Local\cursor-agent\cursor-agent.cmd
# Extra args appended to every Cursor run (whitespace-split), e.g. --sandbox disabled.
# ISOTOPY_CURSOR_ARGS=
# Set to stdin to pipe the prompt instead of passing it as a positional arg.
# ISOTOPY_CURSOR_PROMPT_VIA=stdin
# Set to 0 to drop the --trust flag (e.g. for older CLI versions).
# ISOTOPY_CURSOR_TRUST=0

# --- UI dev server (packages/ui) ---
ISOTOPY_UI_PORT=5173
# Where the Vite proxy sends API calls; defaults to http://localhost:${ISOTOPY_PORT}.
# ISOTOPY_SERVER_URL=http://localhost:9477
# Base URL Playwright tests target; defaults to http://localhost:${ISOTOPY_UI_PORT}.
# ISOTOPY_UI_URL=http://localhost:5173
