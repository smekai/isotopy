{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // @adhd/core is consumed as TypeScript source (its exports map points at
    // src/), so its relative imports carry real .ts extensions — Node's
    // type-stripping and Vite resolve them as-is, and tsc rewrites them to .js
    // when emitting dist. Harmless for packages using .js-extension imports.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  }
}
